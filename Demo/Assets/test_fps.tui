OnCreate = function()
{
    print("OnCreate: ", this.entity)
}

OnDestroy = function()
{
    print("OnDestroy: ", this.entity)
}

OnLoad = function()
{
    print("OnLoad: ", this.entity)
}

OnUnload = function()
{
    print("OnUnload: ", this.entity)
}

OnEnable = function()
{
    print("OnEnable: ", this.entity)
}

OnDisable = function()
{
    print("OnDisable: ", this.entity)
}

fixedCount = 0
fixedTime = 0
frameCount = 0
frameTime = 0

OnFrameUpdate = function()
{
    frameCount++
    frameTime += .Minty.Time.frameDelta
    if (frameTime >= 1)
    {
        print("Frame FPS: ", frameCount)
        frameCount = 0
        frameTime -= 1
    }
}

OnFixedUpdate = function()
{
    fixedCount++
    fixedTime += .Minty.Time.fixedDelta
    if (fixedTime >= 1)
    {
        print("Fixed FPS: ", fixedCount)
        fixedCount = 0
        fixedTime -= 1
    }
}
